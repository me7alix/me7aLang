import "std/net/socket.m7"

struct UdpSocketV4 {
	fd: int
}

static impl UdpSocketV4 {
	fn init() {
		self.fd = socket(AF_INET, SOCK_DGRAM, 0)
	}

	fn bind(addr: *SockAddrV4): int {
		return bind(self.fd, addr:*SockAddr, sizeof(*addr):u32)
	}

	fn send_to(buf: *u0, len: uptr, flags: int, dst: *SockAddrV4): iptr {
		return sendto(self.fd, buf, len, flags, dst, sizeof(*dst):u32)
	}

	fn recv_from(buf: *u0, len: uptr, flags: int, src: *SockAddrV4): iptr {
		al := sizeof(*src):u32
		return recvfrom(self.fd, buf, len, flags, src, &al)
	}

	fn close(): int {
		return close(self.fd)
	}
}
