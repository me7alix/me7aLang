import "std.m7"

// va_flt() promotes floats to doubles
// to match standard C vararg ABI requirements

fn add(a: int, b: float): float {
	return a:float + b
}

fn main() {
	a := 21.3
	b := 3.3

	printf("a = %f\nb = %f\n", va_flt(a), va_flt(b))

	if a > b {
		printf("a > b\n")
	} else {
		printf("a <= b\n")
	}

	printf("%f\n", va_flt(a + b))
	printf("%f\n", va_flt(add(7, 3.7)))
}
