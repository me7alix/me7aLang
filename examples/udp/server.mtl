import "std/libc.m7"
import "std/net/udp.m7"

fn main() {
	addr: SockAddrV4
	addr.set("0.0.0.0", 12345)

	sock: UdpSocketV4
	sock.init()
	sock.bind(&addr)

	buf:    [1024]u8
	client: SockAddrV4

	while true {
		len := sizeof(buf) - 1
		n := sock.recv_from(buf, len, 0, &client)
		buf[n] = '\0'

		ip   := ntohl(client.sin_addr)
		port := ntohs(client.sin_port)

		printf("From: %u.%u.%u.%u:%u\n",
			(ip >> 24) & 0xFF,
			(ip >> 16) & 0xFF,
			(ip >> 8)  & 0xFF,
			(ip >> 0)  & 0xFF,
			port:u32)

		printf("Received: %s", buf)
	}
}
