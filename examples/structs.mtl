import "std.mtl"

struct Person {
	name: *u8
	salary: int
	addr: struct {
		city: *u8
		post_code: int
	}

	fn print() {
		printf(
			"Name: %s\n" \
			"Salary: %d\n",
			self.name,
			self.salary,
		)
		printf(
			"Address: %s [%d]\n",
			self.addr.city,
			self.addr.post_code,
		)
	}
}

fn main() {
	me: Person
	me.name = "Michael"
	me.salary = 777
	me.addr.city = "New York"
	me.addr.post_code = 100101
	me.print()
}
